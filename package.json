  },
  "homepage": "https://github.com/solankiharsh2837/wolverine-db#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
