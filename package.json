{
  "name": "wolverine-db",
  "version": "1.3.0",
  "description": "Independent cryptographic trust layer for databases: Continuous verified state reconstruction, Byzantine quorum consensus, and immutable trust receipts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wdb": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "specs",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY-AUDIT.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsc && node ./dist/demo/run.js",
    "demo:v7": "tsc && node ./dist/demo/run_v7.js",
    "demo:v8": "tsc && node ./dist/demo/run_v8.js",
    "demo:v9": "tsc && node ./dist/demo/run_v9.js",
    "demo:v1": "tsc && node ./dist/demo/run_v1.js",
    "demo:v11": "tsc && node ./dist/demo/run_v11.js",
    "demo:v12": "tsc && node ./dist/demo/run_v12.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "database",
    "integrity",
    "merkle-tree",
    "hash-chain",
    "postgresql",
    "recovery",
    "provenance",
    "tamper-evident",
    "security",
    "byzantine-fault-tolerance",
    "trust-network",
    "trust-receipt",
    "continuous-reconstruction",
    "zero-trust",
    "audit-trail",
    "concurrency-safe",
    "non-malleable"
  ],
  "author": "solankiharsh2837",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solankiharsh2837/wolverine-db.git"
  },
  "bugs": {
    "url": "https://github.com/solankiharsh2837/wolverine-db/issues"
  },
  "homepage": "https://github.com/solankiharsh2837/wolverine-db#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
